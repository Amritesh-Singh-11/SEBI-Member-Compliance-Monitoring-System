# SEBI Member Compliance Monitoring System Environment Variables Template

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sebi_compliance
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password

# Authentication & Security
JWT_SECRET=your_base64_encoded_32_byte_secret_key_here

# Storage Abstraction (local or s3)
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./storage/documents

# AWS S3 Storage (Optional)
S3_BUCKET=sebi-compliance-docs
S3_REGION=ap-south-1
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key

# Python FastAPI ML Service
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_ENABLED=true
